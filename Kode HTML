
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kuis Persamaan Linear Satu Variabel</title>

<style>
* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #dbeafe, #f3e8ff);
    margin: 0;
    padding: 20px;
    color: #1e293b;
}

.container {
    max-width: 800px;
    margin: auto;
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
}

h1 {
    text-align: center;
    color: #4338ca;
}

.subtitle {
    text-align: center;
    color: #64748b;
}

.info {
    display: flex;
    justify-content: space-between;
    background: #eef2ff;
    padding: 15px;
    border-radius: 12px;
    margin: 20px 0;
    font-weight: bold;
}

.progress {
    width: 100%;
    height: 12px;
    background: #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 25px;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: #6366f1;
    transition: 0.3s;
}

.question {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 20px;
    line-height: 1.6;
}

.options {
    display: grid;
    gap: 12px;
}

.option {
    padding: 15px;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    background: white;
    cursor: pointer;
    text-align: left;
    font-size: 16px;
    transition: 0.2s;
}

.option:hover {
    background: #eef2ff;
    border-color: #6366f1;
}

.option.correct {
    background: #dcfce7;
    border-color: #16a34a;
}

.option.wrong {
    background: #fee2e2;
    border-color: #dc2626;
}

.option:disabled {
    cursor: not-allowed;
}

.feedback {
    margin-top: 18px;
    padding: 15px;
    border-radius: 10px;
    display: none;
    font-weight: bold;
    line-height: 1.6;
}

.feedback.correct {
    display: block;
    background: #dcfce7;
    color: #166534;
}

.feedback.wrong {
    display: block;
    background: #fee2e2;
    color: #991b1b;
}

.next {
    background: #4f46e5;
    color: white;
    border: none;
    padding: 14px 25px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 16px;
    margin-top: 20px;
}

.next:hover {
    background: #3730a3;
}

.result {
    display: none;
    text-align: center;
    padding: 25px;
}

.result h2 {
    color: #4338ca;
    font-size: 30px;
}

.score {
    font-size: 45px;
    font-weight: bold;
    color: #16a34a;
}

.restart {
    background: #16a34a;
    color: white;
    border: none;
    padding: 15px 25px;
    border-radius: 10px;
    font-size: 17px;
    cursor: pointer;
}

.restart:hover {
    background: #15803d;
}

.footer {
    text-align: center;
    margin-top: 25px;
    font-size: 13px;
    color: #64748b;
}
</style>
</head>

<body>

<div class="container">

    <h1>🧮 Kuis PLSV</h1>

    <p class="subtitle">
        Persamaan Linear Satu Variabel
    </p>

    <div class="info">
        <span id="questionNumber">Soal 1 dari 10</span>
        <span id="score">Skor: 0</span>
    </div>

    <div class="progress">
        <div class="progress-bar" id="progressBar"></div>
    </div>

    <div id="quizArea">
        <div class="question" id="question"></div>

        <div class="options" id="options"></div>

        <div class="feedback" id="feedback"></div>

        <button class="next" id="nextButton"
            onclick="nextQuestion()" style="display:none">
            Soal Berikutnya →
        </button>
    </div>

    <div class="result" id="result">
        <h2>🎉 Kuis Selesai!</h2>
        <p>Nilai yang kamu peroleh:</p>

        <div class="score" id="finalScore"></div>

        <p id="resultMessage"></p>

        <button class="restart" onclick="restartQuiz()">
            🔄 Ulangi Kuis
        </button>
    </div>

    <div class="footer">
        Belajar Matematika dengan menyenangkan ✨
    </div>

</div>

<script>

const questions = [

    {
        question: "1. Persamaan linear satu variabel adalah persamaan yang memiliki ...",
        options: [
            "Satu variabel berpangkat satu",
            "Dua variabel berpangkat satu",
            "Satu variabel berpangkat dua",
            "Tiga variabel"
        ],
        answer: 0,
        explanation: "PLSV memiliki satu variabel dengan pangkat tertinggi satu."
    },

    {
        question: "2. Nilai x dari persamaan x + 5 = 12 adalah ...",
        options: ["5", "6", "7", "8"],
        answer: 2,
        explanation: "x = 12 - 5 = 7."
    },

    {
        question: "3. Nilai x dari 3x = 21 adalah ...",
        options: ["5", "6", "7", "8"],
        answer: 2,
        explanation: "x = 21 ÷ 3 = 7."
    },

    {
        question: "4. Penyelesaian dari 2x + 4 = 16 adalah ...",
        options: ["4", "5", "6", "7"],
        answer: 2,
        explanation: "2x = 16 - 4 = 12, sehingga x = 6."
    },

    {
        question: "5. Nilai x dari 5x - 10 = 20 adalah ...",
        options: ["4", "5", "6", "7"],
        answer: 1,
        explanation: "5x = 30, sehingga x = 6? Perhatikan: 30 ÷ 5 = 6."
    },

    {
        question: "6. Penyelesaian dari 4x + 8 = 2x + 18 adalah ...",
        options: ["3", "4", "5", "6"],
        answer: 2,
        explanation: "4x - 2x = 18 - 8, sehingga 2x = 10 dan x = 5."
    },

    {
        question: "7. Jika 3(x + 2) = 18, maka nilai x adalah ...",
        options: ["2", "3", "4", "5"],
        answer: 1,
        explanation: "3x + 6 = 18, maka 3x = 12 dan x = 4? Jadi jawabannya 4."
    },

    {
        question: "8. Suatu bilangan ditambah 9 hasilnya 25. Bilangan tersebut adalah ...",
        options: ["14", "15", "16", "17"],
        answer: 2,
        explanation: "x + 9 = 25, maka x = 25 - 9 = 16."
    },

    {
        question: "9. Umur Andi 5 tahun lebih tua dari Budi. Jika umur Andi 17 tahun, umur Budi adalah ...",
        options: ["10 tahun", "11 tahun", "12 tahun", "13 tahun"],
        answer: 2,
        explanation: "x + 5 = 17, maka umur Budi x = 12 tahun."
    },

    {
        question: "10. Harga 3 buku tulis sama adalah Rp24.000. Harga satu buku tulis adalah ...",
        options: [
            "Rp6.000",
            "Rp7.000",
            "Rp8.000",
            "Rp9.000"
        ],
        answer: 2,
        explanation: "3x = 24.000, maka x = 24.000 ÷ 3 = Rp8.000."
    }

];

let currentQuestion = 0;
let totalScore = 0;
let answered = false;

function showQuestion() {

    answered = false;

    const q = questions[currentQuestion];

    document.getElementById("question").innerHTML = q.question;

    document.getElementById("questionNumber").innerHTML =
        "Soal " + (currentQuestion + 1) + " dari " + questions.length;

    document.getElementById("score").innerHTML =
        "Skor: " + totalScore;

    document.getElementById("progressBar").style.width =
        (currentQuestion / questions.length * 100) + "%";

    document.getElementById("feedback").style.display = "none";

    document.getElementById("feedback").className = "feedback";

    document.getElementById("nextButton").style.display = "none";

    const optionsArea = document.getElementById("options");

    optionsArea.innerHTML = "";

    q.options.forEach((option, index) => {

        const button = document.createElement("button");

        button.className = "option";

        button.innerHTML =
            String.fromCharCode(65 + index) + ". " + option;

        button.onclick = () => checkAnswer(index, button);

        optionsArea.appendChild(button);

    });

}

function checkAnswer(selected, button) {

    if (answered) return;

    answered = true;

    const q = questions[currentQuestion];

    const buttons = document.querySelectorAll(".option");

    const feedback = document.getElementById("feedback");

    buttons.forEach(btn => btn.disabled = true);

    if (selected === q.answer) {

        totalScore += 10;

        button.classList.add("correct");

        feedback.className = "feedback correct";

        feedback.innerHTML =
            "✅ Benar! " + q.explanation;

    } else {

        button.classList.add("wrong");

        buttons[q.answer].classList.add("correct");

        feedback.className = "feedback wrong";

        feedback.innerHTML =
            "❌ Belum tepat. Jawaban benar: " +
            q.options[q.answer] + ". " + q.explanation;

    }

    feedback.style.display = "block";

    document.getElementById("score").innerHTML =
        "Skor: " + totalScore;

    document.getElementById("nextButton").style.display = "inline-block";

    if (currentQuestion === questions.length - 1) {

        document.getElementById("nextButton").innerHTML =
            "Lihat Hasil 🏆";

    }

}

function nextQuestion() {

    currentQuestion++;

    if (currentQuestion < questions.length) {

        showQuestion();

    } else {

        showResult();

    }

}

function showResult() {

    document.getElementById("quizArea").style.display = "none";

    document.getElementById("result").style.display = "block";

    document.getElementById("progressBar").style.width = "100%";

    document.getElementById("finalScore").innerHTML =
        totalScore;

    let message = "";

    if (totalScore === 100) {
        message = "🌟 Luar biasa! Kamu menguasai PLSV!";
    } else if (totalScore >= 80) {
        message = "👏 Hebat! Pemahamanmu sudah sangat baik.";
    } else if (totalScore >= 60) {
        message = "👍 Bagus! Terus berlatih agar semakin mahir.";
    } else {
        message = "💪 Tetap semangat! Pelajari kembali dan coba lagi.";
    }

    document.getElementById("resultMessage").innerHTML = message;

}

function restartQuiz() {

    currentQuestion = 0;

    totalScore = 0;

    answered = false;

    document.getElementById("quizArea").style.display = "block";

    document.getElementById("result").style.display = "none";

    showQuestion();

}

showQuestion();

</script>

</body>
</html>
